root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
max_line_length = 80

[*.md]
indent_style = space
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_style = space

[package.json]
indent_style = space