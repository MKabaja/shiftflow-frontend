{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!!**/dist", "!src/routeTree.gen.ts"] },
	"plugins": [
		"./biome-plugins/function-declarations.grit",
		"./biome-plugins/no-switch.grit",
		{
			"path": "./biome-plugins/prefer-user-event.grit",
			"includes": ["**/__tests__/**"]
		},
		{
			"path": "./biome-plugins/prefer-screen.grit",
			"includes": ["**/__tests__/**"]
		},
		{
			"path": "./biome-plugins/no-container-access.grit",
			"includes": [
				"**/__tests__/**",
				"!**/Avatar/__tests__/Avatar.test.tsx",
				"!**/Card/__tests__/Card.test.tsx",
				"!**/ColorPicker/__tests__/ColorPicker.test.tsx",
				"!**/Skeleton/__tests__/Skeleton.test.tsx",
				"!**/Toggle/__tests__/Toggle.test.tsx"
			]
		},
		{
			"path": "./biome-plugins/await-find-queries.grit",
			"includes": ["**/__tests__/**"]
		},
		{
			"path": "./biome-plugins/prefer-presence-queries.grit",
			"includes": ["**/__tests__/**"]
		}
	],
	"formatter": {
		"enabled": true,
		"includes": ["**", "!**/*.md", "!package.json"],
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"attributePosition": "multiline"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"tailwind": {
		"stylesheet": "./src/css/Index.css"
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useMaxParams": { "level": "error", "options": { "max": 4 } }
			},
			"correctness": {
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"noNestedComponentDefinitions": "error",
				"useJsxKeyInIterable": "error",
				"useImportExtensions": "error"
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error"
			},
			"style": {
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": { "style": "type" }
				},
				"useImportType": "error",
				"noNonNullAssertion": "error",
				"noDefaultExport": "error",
				"noNestedTernary": "error",
				"noNamespace": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": { "filenameCases": ["camelCase", "PascalCase"] }
				},
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": { "kind": "function" },
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": { "kind": "variable" },
								"formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "objectLiteralProperty" },
								"formats": [
									"camelCase",
									"snake_case",
									"PascalCase",
									"CONSTANT_CASE"
								]
							},
							{
								"selector": { "kind": "typeProperty" },
								"formats": ["camelCase", "snake_case"]
							}
						]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": { "level": "error", "options": { "allow": ["error"] } },
				"noArrayIndexKey": "error",
				"noFocusedTests": "error",
				"noSkippedTests": "error",
				"noExportsInTest": "error",
				"noDuplicateTestHooks": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useTailwindSortedClasses": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.d.ts", "src/app/queryClient.ts", "src/app/router.ts"],
			"linter": {
				"rules": { "style": { "useConsistentTypeDefinitions": "off" } }
			}
		},
		{
			"includes": ["**/*.svg"],
			"linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
		},
		{
			"includes": [
				"src/features/news/components/NewsFeedLoading/NewsFeedLoading.tsx",
				"src/shared/components/PinInput/PinInput.tsx"
			],
			"linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
		},
		{
			"includes": [
				"src/shared/components/ColorPicker/ColorPicker.tsx",
				"src/shared/components/LocaleSwitcher/LocaleSwitcher.tsx",
				"src/shared/components/Separator/Separator.tsx"
			],
			"linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
		},
		{
			"includes": ["src/css/globals.css"],
			"linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
		},
		{
			"includes": ["vite.config.ts", "vitest.config.ts"],
			"linter": {
				"rules": {
					"style": { "noDefaultExport": "off", "useNamingConvention": "off" }
				}
			}
		},
		{
			"includes": ["src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/features/**", "@/app/**", "@/routes/**"],
										"message": "shared/ must not depend on features/, app/ or routes/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/app/**", "@/routes/**"],
										"message": "features/ must not depend on app/ or routes/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/routes/**", "src/vite-env.d.ts"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": { "filenameCases": ["kebab-case"] }
						}
					}
				}
			}
		}
	]
}
